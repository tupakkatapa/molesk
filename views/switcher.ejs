  <dialog class="switcher" aria-label="Go to a page"<% if (editMode) { %> data-create<% } %>>
    <div class="switcher-field">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="text" class="switcher-input" role="combobox" aria-label="Page name or text" aria-controls="switcherList" aria-expanded="true" aria-autocomplete="list" placeholder="Go to a page or search the text" autocomplete="off" spellcheck="false" enterkeyhint="go">
      <kbd class="switcher-key">Esc</kbd>
    </div>
    <ul class="switcher-list" id="switcherList" role="listbox" aria-label="Pages"></ul>
    <p class="switcher-note" role="status"></p>
  </dialog>
