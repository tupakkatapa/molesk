<!DOCTYPE html>
<html lang="en" data-theme="<%= theme === 'light' ? 'light' : 'dark' %>" data-theme-default="<%= theme %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#1a1812">
  <title><%= pageTitle %></title>
<%_ if (showRss) { _%>
  <link rel="alternate" type="application/rss+xml" title="<%= title %>" href="/rss.xml">
<%_ } _%>
<%_ if (typeof preview !== "undefined") { _%>
<%- include("meta", { preview }) _%>
<%_ } _%>
  <% if (image) { %>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="/profile-pic" as="image">
  <% } %>

  <link rel="stylesheet" href="/base.css">
  <link rel="stylesheet" href="/sidebar.css">
  <link rel="stylesheet" href="/markdown.css">
  <link rel="stylesheet" href="/folder.css">
  <link rel="stylesheet" href="/mobile.css">
  <% if (editMode) { %>
  <link rel="stylesheet" href="/editor.css">
  <% } %>
  <link rel="stylesheet" href="/literata.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/fontawesome.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/solid.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/regular.min.css">
  <link rel="stylesheet" href="/vendor/fontawesome/css/brands.min.css">
  <link rel="stylesheet" id="highlightjs-light" href="/vendor/highlight.js/github.min.css" disabled>
  <link rel="stylesheet" id="highlightjs-dark" href="/vendor/highlight.js/github-dark.min.css">
  <script src="/theme.js"></script>
</head>
<body<% if (typeof singleFile !== 'undefined' && singleFile) { %> class="single-file-mode"<% } %>>
  <div class="container">
    <% if (typeof singleFile !== 'undefined' && singleFile) { %>
    <button class="theme-toggle single-file-theme-toggle" id="themeToggleIcon" title="Toggle Theme" aria-label="Toggle between light and dark theme">
      <i class="fa-solid fa-circle-half-stroke"></i>
    </button>
    <% } %>
<%_ const single = typeof singleFile !== "undefined" && singleFile; _%>
<%_ const switcher = showSearch && !single; _%>
    <% if (!single) { %>
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <nav class="sidebar" id="sidebar" aria-label="Site navigation">
      <% const profile = image && imageSize === "large"; %>
      <div class="sidebar-head">
        <% if (!profile) { %>
        <a class="site-name" href="/"><% if (image) { %><img src="/profile-pic" alt=""><% } %><span>~ <%= title %></span></a>
        <% } %>
        <button type="button" class="icon-btn theme-toggle" id="themeToggleIcon" title="Toggle theme (t)" aria-label="Toggle between light and dark theme"><i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i></button>
        <button type="button" class="icon-btn sidebar-close" id="collapseSidebar" aria-controls="sidebar" aria-label="Hide sidebar" title="Hide sidebar"><i class="fa-solid fa-angles-left on-wide" aria-hidden="true"></i><i class="fa-solid fa-xmark on-narrow" aria-hidden="true"></i></button>
      </div>
      <div class="sidebar-content">
        <% if (profile) { %>
        <a class="profile" href="/"><img src="/profile-pic" alt=""><span class="profile-name">~ <%= title %></span></a>
        <% } %>
        <% if (showSearch) { %>
        <div class="tree-search">
          <input type="search" class="tree-filter" placeholder="Search" title="Search (/)" aria-label="Search pages by name" autocomplete="off">
<%_ if (switcher) { _%>
          <button type="button" class="sidebar-search" aria-label="Search page text" title="Search page text (Ctrl+K)"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
<%_ } _%>
        </div>
        <% } %>
        <div class="navigation-buttons">
          <ul class="tree" style="--depth: 0">
            <%- include('tree', { items: tree, depth: 0, dir: '', current: typeof current === 'undefined' ? '' : current }) %>
          </ul>
          <% if (showSearch) { %>
          <p class="tree-empty" role="status" hidden>No pages match</p>
          <% } %>
        </div>
      </div>
      <% if (socialLinks.length > 0 || sourceLink || showRss) { %>
      <div class="sidebar-links">
        <% socialLinks.forEach(function(link) { %><a href="<%= link.href %>" class="social-link" aria-label="<%= link.fab.replace('fa-', '') %>"><i class="fab <%= link.fab %>"></i></a><% }); %>
        <% if (sourceLink) { %>
        <a href="<%= sourceLink %>" class="social-link" title="Source Code" aria-label="Source Code"><i class="fa-solid fa-code"></i></a>
        <% } %>
        <% if (showRss) { %>
        <a href="#" class="social-link rss-copy-link" title="Copy RSS Feed Link" aria-label="Copy RSS Feed Link" data-rss-url="/rss.xml"><i class="fa-solid fa-rss"></i></a>
        <% } %>
      </div>
      <% } %>
    </nav>
    <% } %>
    <main class="main" role="main">
      <% if (typeof singleFile === 'undefined' || !singleFile) { %>
      <header class="topbar">
        <button class="menu-btn icon-btn" id="menuToggle" aria-controls="sidebar" aria-label="Open navigation"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
        <div class="topbar-text">
          <span class="topbar-title"><%= typeof heading !== 'undefined' ? heading : title %></span>
          <% if (typeof editor !== 'undefined') { %><span class="editor-status topbar-status" aria-hidden="true"></span><% } %>
        </div>
<%_ if (switcher) { _%>
        <button type="button" class="icon-btn topbar-search" aria-label="Search" title="Search (Ctrl+K)"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
<%_ } _%>
        <% if (typeof editor !== 'undefined') { %>
        <a class="btn btn-primary editor-done" href="/content/<%= editor.href %>">Done</a>
        <% } else { %>
        <a class="icon-btn topbar-edit" href="#" aria-label="Edit" title="Edit (e)" hidden><i class="fa-solid fa-pen" aria-hidden="true"></i></a>
        <a class="icon-btn topbar-download" href="#" aria-label="Download" title="Download" hidden><i class="fa-solid fa-download" aria-hidden="true"></i></a>
        <% } %>
      </header>
      <% } %>
      <% if (typeof editor !== 'undefined') { %>
      <%- include('editor', editor) %>
      <% } else { %>
      <div id="file-content" class="markdown-body" data-path="<%= typeof current === 'undefined' ? '' : current %>">
        <%- typeof actions !== 'undefined' ? actions : '' %>
        <%- initialContent %>
      </div>
      <% } %>
    </main>
  </div>
<%_ if (switcher) { _%>
<%- include("switcher") _%>
<%_ } _%>

  <script type="module" src="/main.js"></script>
  <script type="module" src="/content.js"></script>
<%_ if (switcher) { _%>
  <script type="module" src="/switcher.js"></script>
<%_ } _%>
  <% if (editMode) { %>
  <script type="module" src="/notes.js"></script>
  <% if (typeof editor !== 'undefined') { %>
  <script type="module" src="/editor-format.js"></script>
  <script type="module" src="/editor-preview.js"></script>
  <script type="module" src="/editor-actions.js"></script>
  <script type="module" src="/editor-upload.js"></script>
  <% if (editor.history) { %>
  <script type="module" src="/editor-history.js"></script>
  <% } %>
  <% } %>
  <% } %>
</body>
</html>
